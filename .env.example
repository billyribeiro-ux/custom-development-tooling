# .env.example — a COMMITTED template that documents every variable the
# project understands. Copy it to `.env` (which is gitignored) and fill in
# real values:  cp .env.example .env
#
# Rule of thumb: .env.example is documentation; .env is a secret. Never swap them.

# ---- Site build -----------------------------------------------------------
# Where generated HTML is written (relative to the repo root).
SITE_OUTPUT_DIR=site

# Base path the site is served under. "/" for local file://; for GitHub Pages
# project sites it is usually "/<repo-name>/".
SITE_BASE_PATH=/

# ---- Example app (used by the database lessons) ---------------------------
# A connection string. The value below is a safe local placeholder — the real
# one lives only in your private .env and in your CI secrets store.
DATABASE_URL=postgres://dev:dev@localhost:5432/app_dev

# Pretend secret to demonstrate validation + "never log this" patterns.
API_TOKEN=replace-me-with-a-real-token

# ---- Behavior toggles -----------------------------------------------------
# LOG_LEVEL is read by the example scripts: debug | info | warn | error
LOG_LEVEL=info
